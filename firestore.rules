rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══ Helpers ═══════════════════════════════════════════════
    function isAuth() {
      return request.auth != null;
    }
    // Lookup del doc de usuario en /usuarios/{uid} (ID = Firebase Auth UID).
    // Las reglas usan esto para otorgar permisos dinámicamente sin tocar este archivo.
    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function userRole() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        ? userDoc().data.rol : '';
    }
    function userActivo() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && userDoc().data.estado == 'activo';
    }

    // Bootstrap: cuentas reales activas en /usuarios (ver Admin-Usuarios.html),
    // repetidas aquí como respaldo por si el doc de Firestore no existe o falla el lookup.
    // Única fuente de verdad para editar personal: Admin-Usuarios.html + estas listas.
    //   Admin:   rubenwainwrightba@gmail.com, skarleth.admoncmg@gmail.com,
    //            administracion@clinicamedicacmg.net
    //   Médico:  reneherrerarojas667@gmail.com
    //   Caja · Enfermería (rol enf): luzidaliaortiz2021@gmail.com,
    //            ruizterann83@gmail.com, caja.clinicacmg@gmail.com

    // isCaja: recepción/cobros. Rol Firestore: caja | enf | admin.
    function isCaja() {
      return isAuth() && (
        request.auth.token.email in [
          'rubenwainwrightba@gmail.com',
          'skarleth.admoncmg@gmail.com',
          'administracion@clinicamedicacmg.net',
          'luzidaliaortiz2021@gmail.com',
          'ruizterann83@gmail.com',
          'caja.clinicacmg@gmail.com'
        ]
        || (userActivo() && userRole() in ['caja', 'enf', 'admin'])
      );
    }
    // isDoctor: acceso clínico completo. Rol Firestore: medico | enf | admin.
    function isDoctor() {
      return isAuth() && (
        request.auth.token.email in [
          'rubenwainwrightba@gmail.com',
          'skarleth.admoncmg@gmail.com',
          'administracion@clinicamedicacmg.net',
          'reneherrerarojas667@gmail.com',
          'luzidaliaortiz2021@gmail.com',
          'ruizterann83@gmail.com',
          'caja.clinicacmg@gmail.com'
        ]
        || (userActivo() && userRole() in ['medico', 'enf', 'admin'])
      );
    }
    // isAdmin: acceso total a portales y configuración. Rol Firestore: admin.
    function isAdmin() {
      return isAuth() && (
        request.auth.token.email in [
          'rubenwainwrightba@gmail.com',
          'skarleth.admoncmg@gmail.com',
          'administracion@clinicamedicacmg.net'
        ]
        || (userActivo() && userRole() == 'admin')
      );
    }
    // isEnfermeria: personal de enfermería. Rol Firestore: enf | admin.
    // Incluye las cuentas reales de "Caja · Enfermería" como respaldo (igual que
    // isCaja()/isDoctor()), porque antes solo dependía del doc en /usuarios y
    // dejaba bloqueadas esas cuentas si el doc no existía o no tenía rol/estado
    // correctos, aunque isCaja()/isDoctor() sí las reconocieran.
    function isEnfermeria() {
      return isAuth() && (
        request.auth.token.email in [
          'rubenwainwrightba@gmail.com',
          'skarleth.admoncmg@gmail.com',
          'administracion@clinicamedicacmg.net',
          'luzidaliaortiz2021@gmail.com',
          'ruizterann83@gmail.com',
          'caja.clinicacmg@gmail.com'
        ]
        || (userActivo() && userRole() in ['enf', 'admin'])
      );
    }
    // isMedicoTratante: SOLO médico (rol medico | admin, o correos de doctores).
    // A diferencia de isDoctor(), NO incluye enfermería: se usa para la finalización
    // de la Consulta médica (diagnóstico/tratamiento), que solo puede hacer el médico
    // físicamente presente en el consultorio, incluso si hay dos turnos y el médico
    // no está siempre frente a la computadora.
    function isMedicoTratante() {
      return isAuth() && (
        request.auth.token.email in [
          'rubenwainwrightba@gmail.com',
          'skarleth.admoncmg@gmail.com',
          'administracion@clinicamedicacmg.net',
          'reneherrerarojas667@gmail.com'
        ]
        || (userActivo() && userRole() in ['medico', 'admin'])
      );
    }
    // esServicioEnfermeria: servicios (status 'servicio') que Caja/Enfermería pueden
    // completar sin médico. Todo lo demás del catálogo (Procedimientos como
    // Cauterización/Extracción de uña/Lavado de oído, Cuidado de la mujer, vías
    // urinarias, y el resto de "Servicios generales") requiere isMedicoTratante().
    // MANTENER EN SYNC con SERVICIOS_ENFERMERIA en Expediente-Doctor.html.
    function esServicioEnfermeria(nombre) {
      return nombre in [
        'Toma de presión', 'Glucometría', 'Nebulización (ciclo)',
        'Inyección intramuscular (IM)', 'Inyección intravenosa (IV)',
        'Aplicación de Suero',
        'Sueroterapia Complejo B', 'Sueroterapia Oxigenador Cerebral',
        'Sueroterapia Vitamina C', 'Sueroterapia Vitamina D',
        'Sueroterapia Hígado Detox', 'Sueroterapia Boost (Complejo B + Oxigenador)',
        'Sueroterapia Colágeno', 'Sueroterapia Glutatión', 'Sueroterapia Ácido Ascórbico (Vit C)',
        'Sueroterapia Glutatión + Vit C (media dosis)', 'Sueroterapia Glutatión + Vit C (completo)'
      ];
    }

    // ═══ /users/{uid} ══════════════════════════════════════════
    // Perfil del usuario (códigos de expediente vinculados/compartidos).
    match /users/{userId} {
      allow read: if (isAuth() && request.auth.uid == userId) || isAdmin();
      allow create, update: if isAuth() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // ═══ /expedientes/{codigo} ═════════════════════════════════
    match /expedientes/{codigo} {
      // Cualquier usuario autenticado puede leer un expediente si conoce el código.
      // El código único actúa como control de acceso.
      allow read: if isDoctor() || isCaja() || isAuth();

      // Solo el doctor crea expedientes.
      allow create: if isDoctor();

      // Update:
      //   - Doctor: siempre.
      //   - Paciente sin owner asignado: puede reclamar (set ownerUid).
      //   - Paciente con owner: solo agregarse a sí mismo a compartidoCon.
      allow update: if isDoctor()
        || (
          isAuth()
          && resource.data.ownerUid == null
          && request.resource.data.ownerUid == request.auth.uid
        )
        || (
          isAuth()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['compartidoCon', 'solicitudesAcceso', 'updatedAt'])
        )
        || (
          isAuth()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['solicitudesAcceso', 'updatedAt'])
        );

      allow delete: if isDoctor();
    }

    // ═══ /consultas/{id} ═══════════════════════════════════════
    // Caja puede LEER y LIQUIDAR consultas.
    // La Consulta médica (diagnóstico/tratamiento, preclinica → pendiente_caja) es
    // función EXCLUSIVA del médico tratante: solo puede hacerse en el consultorio,
    // aunque haya dos turnos y el médico no esté siempre frente a la computadora.
    // Un Servicio (status 'servicio', p.ej. inyecciones) sí puede ser continuado y
    // completado por Caja o Enfermería, para no depender de que el médico esté presente.
    // Caja solo puede hacer update cuando el status pasa de pendiente_caja → completa
    // (liquidación de pago), no puede crear ni borrar consultas.
    match /consultas/{consultaId} {
      allow read: if isDoctor() || isCaja()
        || (
          isAuth()
          && exists(/databases/$(database)/documents/expedientes/$(resource.data.codigoPaciente))
          && (
            get(/databases/$(database)/documents/expedientes/$(resource.data.codigoPaciente)).data.ownerUid == request.auth.uid
            || (
              get(/databases/$(database)/documents/expedientes/$(resource.data.codigoPaciente)).data.compartidoCon is list
              && request.auth.uid in get(/databases/$(database)/documents/expedientes/$(resource.data.codigoPaciente)).data.compartidoCon
            )
          )
        );

      // Caja puede crear entradas standalone (prueba-rapida y lab) para liquidación,
      // y el registro inicial de visita (Etapa 1: Consulta o Servicio), que queda
      // 'listo_enfermeria' sin datos clínicos todavía.
      // Pre clínica (vitales) y registro de un Servicio ya con datos clínicos los
      // crea el personal clínico (médico o enfermería), vía isDoctor().
      // Excepción: servicios sin preclínica (Extracción de uña, Lavado de oído,
      // Retiro de puntos) que Caja registra directo en 'servicio' (Pendiente para
      // Médico), sin pasar por Enfermería.
      allow create: if isDoctor()
        || (isCaja()
            && request.resource.data.status == 'pendiente_caja'
            && request.resource.data.tipoRegistro in ['lab-standalone', 'prueba-standalone'])
        || (isCaja() && request.resource.data.status == 'listo_enfermeria')
        || (isCaja()
            && request.resource.data.status == 'servicio'
            && request.resource.data.tipo == 'servicio'
            && request.resource.data.servicioNombre in ['Extracción de uña', 'Lavado de oído', 'Retiro de puntos']);
      // Borrar consultas/servicios del historial completo es solo para Administración
      // (limpieza de registros de prueba/errores en un expediente real).
      // Excepción: médico o enfermería pueden cancelar, desde su propio formulario
      // de atención, un registro que nunca se realizó — pero SOLO mientras siga en
      // una etapa temprana (antes de pasar a Caja/liquidación), para no arriesgar
      // un registro ya facturado o pagado. Caja NO puede borrar (isCaja() != isDoctor()
      // salvo que la cuenta también tenga rol 'enf').
      allow delete: if isAdmin()
        || (
          isDoctor()
          && resource.data.status in ['listo_enfermeria', 'preclinica', 'servicio']
        );

      // Update:
      //   - Médico tratante: siempre, incluida la finalización de la Consulta médica
      //     (preclinica → pendiente_caja).
      //   - Enfermería: atiende un registro 'listo_enfermeria' (toma signos vitales
      //     y, si aplica, prueba de sensibilidad) y lo pasa a 'preclinica' (Consulta)
      //     o 'servicio' (Servicio), listo para la siguiente etapa.
      //   - Caja o Enfermería: SOLO pueden continuar/completar un Servicio de
      //     esServicioEnfermeria() (status 'servicio' → 'servicio-completo' o
      //     'pendiente_caja'). Nunca una Consulta médica, ni un Servicio fuera de
      //     esa lista (esos, como Cauterización o Extracción de uña, requieren
      //     isMedicoTratante(), cubierto por la primera condición de este allow).
      //     También pueden autoguardar el progreso mientras completan uno permitido
      //     (status 'servicio' se mantiene igual, no es una transición).
      //   - Caja: liquidar el pago (pendiente_caja → completa). También liquida en el
      //     mismo batch los servicios hijos vinculados, que llegan con status
      //     'servicio-completo' (DRM v3 #6), por eso se incluye ese estado también.
      allow update: if isMedicoTratante()
        || (
          isEnfermeria()
          && resource.data.status == 'listo_enfermeria'
          && request.resource.data.status in ['preclinica', 'servicio']
        )
        || (
          (isCaja() || isEnfermeria())
          && resource.data.status == 'servicio'
          && esServicioEnfermeria(resource.data.servicioNombre)
          && request.resource.data.status in ['servicio', 'servicio-completo', 'pendiente_caja']
        )
        || (isCaja()
            && resource.data.status in ['pendiente_caja', 'servicio-completo']
            && request.resource.data.status == 'completa');
    }

    // ═══ /quotations/{id} ══════════════════════════════════════
    // Cotizaciones guardadas: cada usuario lee/escribe solo las suyas.
    // Admin puede leer y borrar todo (para limpieza).
    match /quotations/{quotationId} {
      allow read: if (isAuth() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
    }

    // ═══ /d365solicitudes/{id} ═════════════════════════════════
    // Solicitudes del programa Doctor 365:
    //   - Usuario: lee/crea/actualiza solo las suyas.
    //   - Admin y Caja: leen y modifican todas (gestión de membresías en recepción).
    match /d365solicitudes/{solId} {
      allow read: if isAdmin() || isCaja()
        || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || isCaja()
        || (isAuth() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || isCaja();

      // Subcolección /dependientes/{depId}
      match /dependientes/{depId} {
        allow read: if isAdmin() || isCaja()
          || (isAuth()
              && get(/databases/$(database)/documents/d365solicitudes/$(solId)).data.userId == request.auth.uid);
        allow create: if isAuth()
          && get(/databases/$(database)/documents/d365solicitudes/$(solId)).data.userId == request.auth.uid;
        allow update, delete: if isAdmin() || isCaja()
          || (isAuth()
              && get(/databases/$(database)/documents/d365solicitudes/$(solId)).data.userId == request.auth.uid);
      }
    }

    // ═══ /resultadosPruebas/{id} ═════════════════════════════
    // Resultados de pruebas rápidas:
    //   - Staff (isDoctor): lectura/escritura total.
    //   - Caja: solo lectura.
    //   - Paciente: puede leer las pruebas ligadas a su expediente.
    match /resultadosPruebas/{resultadoId} {
      allow read: if isDoctor() || isCaja()
        || (
          isAuth()
          && resource.data.codigoPaciente != null
          && exists(/databases/$(database)/documents/expedientes/$(resource.data.codigoPaciente))
          && (
            get(/databases/$(database)/documents/expedientes/$(resource.data.codigoPaciente)).data.ownerUid == request.auth.uid
            || (
              get(/databases/$(database)/documents/expedientes/$(resource.data.codigoPaciente)).data.compartidoCon is list
              && request.auth.uid in get(/databases/$(database)/documents/expedientes/$(resource.data.codigoPaciente)).data.compartidoCon
            )
          )
        );
      // Caja puede crear y actualizar pruebas rápidas (recepción las registra).
      allow create, update: if isDoctor() || isCaja();
      allow delete:         if isDoctor();
    }

    // ═══ /examenesLaboratorio/{id} ════════════════════════════
    // Exámenes de laboratorio externos (PDFs):
    //   - Staff (isDoctor): lectura/escritura total.
    //   - Caja: lectura y carga de exámenes (sin editar ni borrar).
    //   - Paciente: puede leer los exámenes ligados a su expediente.
    //   - Paciente: puede CREAR (subir) exámenes solo a SU PROPIO expediente
    //     (ownerUid === su uid), siempre con flag subidoPorPaciente=true.
    match /examenesLaboratorio/{examenId} {
      allow read: if isDoctor() || isCaja()
        || (
          isAuth()
          && resource.data.codigoPaciente != null
          && exists(/databases/$(database)/documents/expedientes/$(resource.data.codigoPaciente))
          && (
            get(/databases/$(database)/documents/expedientes/$(resource.data.codigoPaciente)).data.ownerUid == request.auth.uid
            || (
              get(/databases/$(database)/documents/expedientes/$(resource.data.codigoPaciente)).data.compartidoCon is list
              && request.auth.uid in get(/databases/$(database)/documents/expedientes/$(resource.data.codigoPaciente)).data.compartidoCon
            )
          )
        );
      allow create: if isDoctor() || isCaja()
        || (
          isAuth()
          && request.resource.data.codigoPaciente != null
          && request.resource.data.subidoPorPaciente == true
          && exists(/databases/$(database)/documents/expedientes/$(request.resource.data.codigoPaciente))
          && get(/databases/$(database)/documents/expedientes/$(request.resource.data.codigoPaciente)).data.ownerUid == request.auth.uid
        );
      // Caja puede actualizar (marcar procesando, subir resultado PDF).
      allow update: if isDoctor() || isCaja();
      allow delete: if isDoctor();
    }

    // ═══ /solicitudesUnificacion/{id} ══════════════════════════
    // DRM Fun-5 v2: solicitudes de unificación de expedientes.
    //   - Doctor: puede crear y leer las suyas (estado pendiente).
    //   - Admin: lee/aprueba/rechaza todas y ejecuta la unificación real.
    match /solicitudesUnificacion/{solId} {
      allow read: if isDoctor();
      allow create: if isDoctor()
        && request.resource.data.solicitadoPor == request.auth.token.email
        && request.resource.data.estado == 'pendiente';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ═══ /constancias/{id} ═════════════════════════════════════
    // DRM Fun-11 v2: constancias médicas (incapacidades).
    //   - Staff: lectura/escritura total.
    //   - Caja: solo lectura.
    //   - Paciente: puede leer las constancias ligadas a su expediente.
    match /constancias/{constanciaId} {
      allow read: if isDoctor() || isCaja()
        || (
          isAuth()
          && resource.data.codigoPaciente != null
          && exists(/databases/$(database)/documents/expedientes/$(resource.data.codigoPaciente))
          && (
            get(/databases/$(database)/documents/expedientes/$(resource.data.codigoPaciente)).data.ownerUid == request.auth.uid
            || (
              get(/databases/$(database)/documents/expedientes/$(resource.data.codigoPaciente)).data.compartidoCon is list
              && request.auth.uid in get(/databases/$(database)/documents/expedientes/$(resource.data.codigoPaciente)).data.compartidoCon
            )
          )
        );
      allow create, update: if isDoctor();
      // Borrar una constancia es solo para Administración.
      allow delete: if isAdmin();
    }

    // ═══ /electrocardiogramas/{id} ═══════════════════════════════
    // Hoja de resultados del servicio "Electrocardiograma" (informe + foto del trazo).
    //   - Staff: lectura/escritura total.
    //   - Caja: solo lectura.
    //   - Paciente: puede leer los electrocardiogramas ligados a su expediente.
    match /electrocardiogramas/{ekgId} {
      allow read: if isDoctor() || isCaja()
        || (
          isAuth()
          && resource.data.codigoPaciente != null
          && exists(/databases/$(database)/documents/expedientes/$(resource.data.codigoPaciente))
          && (
            get(/databases/$(database)/documents/expedientes/$(resource.data.codigoPaciente)).data.ownerUid == request.auth.uid
            || (
              get(/databases/$(database)/documents/expedientes/$(resource.data.codigoPaciente)).data.compartidoCon is list
              && request.auth.uid in get(/databases/$(database)/documents/expedientes/$(resource.data.codigoPaciente)).data.compartidoCon
            )
          )
        );
      allow create, update, delete: if isDoctor();
    }

    // ═══ /catalogoConfig/{itemKey} ════════════════════════════
    // Overrides de precio público, % de descuento Doctor 365 y
    // exclusiones por ítem, gestionados desde Admin-Precios.html.
    //   - Lectura PÚBLICA: el Cotizador lo usan visitantes anónimos.
    //   - Escritura: solo Admin (Caja NO puede modificar precios/descuentos).
    match /catalogoConfig/{itemKey} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ═══ /usuarios/{id} ════════════════════════════════════════
    // Cuentas del personal gestionadas desde Admin-Usuarios.html.
    // Solo admins pueden leer y escribir.
    match /usuarios/{userId} {
      allow read: if isAdmin() || (isAuth() && request.auth.uid == userId);
      allow write: if isAdmin();
    }

    // ═══ /siteConfig/{doc} ══════════════════════════════════════
    // Configuración pública del sitio (horario, anuncio, contacto).
    // Lectura pública (Inicio.html sin auth). Escritura solo admins.
    match /siteConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ═══ /estadisticas/{id} ═══════════════════════════════════════
    // Contadores agregados (ej. total de expedientes creados) para mostrar
    // en el panel sin tener que leer toda la colección de expedientes — el
    // SDK de Firestore que usa el sitio no soporta consultas count().
    // Doctor/Caja: leen (para mostrar el total en el panel).
    // Doctor: escribe (incrementa al crear un expediente).
    // Admin: puede corregir el valor (herramienta de reindexado/mantenimiento).
    match /estadisticas/{id} {
      allow read: if isDoctor() || isCaja();
      allow write: if isDoctor() || isAdmin();
    }

    // ═══ Bloqueo por defecto ═══════════════════════════════════
    // Cualquier otra colección queda bloqueada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
