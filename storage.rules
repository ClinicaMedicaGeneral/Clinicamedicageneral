rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuth() {
      return request.auth != null;
    }

    // Lookup dinámico del rol en Firestore /usuarios/{uid} (mismo modelo
    // que firestore.rules): usuarios creados desde Admin-Usuarios.html
    // obtienen acceso automáticamente sin tocar este archivo.
    function userActivo() {
      return firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.estado == 'activo';
    }
    function userRole() {
      return firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
        ? firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol : '';
    }

    // isDoctor: acceso clínico completo. Rol Firestore: medico | enf | admin.
    // Bootstrap = cuentas reales activas en /usuarios (ver Admin-Usuarios.html),
    // mismo criterio que firestore.rules.
    function isDoctor() {
      return isAuth() && (
        request.auth.token.email in [
          'rubenwainwrightba@gmail.com',
          'skarleth.admoncmg@gmail.com',
          'administracion@clinicamedicacmg.net',
          'reneherrerarojas667@gmail.com',
          'luzidaliaortiz2021@gmail.com',
          'ruizterann83@gmail.com',
          'caja.clinicacmg@gmail.com'
        ]
        || (userActivo() && userRole() in ['medico', 'enf', 'admin'])
      );
    }

    // ─── Archivos de expedientes (PDFs de consulta, Word del expediente) ──
    // Estructura: /expedientes/{codigoPaciente}/...
    //   - Lectura: cualquier usuario autenticado (la URL es secreta y se
    //     guarda en Firestore, que está protegido por las rules de Firestore).
    //   - Escritura: solo doctores autorizados.
    match /expedientes/{codigo}/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isDoctor();
    }

    // ─── Exámenes de laboratorio (PDFs externos) ──
    // Estructura: /examenes-laboratorio/{codigoPaciente|paciente-{uid}|sin-expediente}/...
    //   - Lectura: cualquier usuario autenticado.
    //   - Escritura: doctores (a cualquier carpeta) y pacientes
    //     (cualquier autenticado puede subir; control real vía Firestore
    //     que solo permite vincular a su propio expediente).
    match /examenes-laboratorio/{folder}/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // ─── Cualquier otra ruta ──
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
